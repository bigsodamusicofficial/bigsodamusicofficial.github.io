<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio Grid Demo</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #000;
            color: #fff;
            font-family: 'Helvetica Neue', Arial, sans-serif;
            overflow-y: auto; /* Enable vertical scrolling */
        }
        #canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1; /* Send it behind UI elements */
        }
        #content-wrapper {
            position: relative;
            min-height: 100vh;
            padding-bottom: 2000px; /* Much more space at bottom for extended scrolling */
        }
        #info {
            position: fixed; /* instead of absolute */
            bottom: 20px;
            left: 20px;
            background-color: rgba(0, 0, 0, 0.8);
            padding: 20px;
            border-radius: 5px;
            max-width: 400px;
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: none;
            transition: all 0.3s ease;
            cursor: pointer;
            z-index: 1000; /* Ensure it's above the canvas */
        }
        #info h2 {
            margin-top: 0;
            color: #fff;
            font-size: 24px;
            font-weight: 300;
        }
        #info p {
            line-height: 1.5;
            margin-bottom: 10px;
        }
        .click-hint {
            font-size: 0.9em;
            color: #aaa;
            font-style: italic;
            text-align: right;
            margin-top: 15px !important;
        }
        .header {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 10;
        }
        .header h1 {
            font-size: 28px;
            font-weight: 300;
            margin: 0;
            padding: 0;
        }
        #instructions {
            position: absolute;
            top: 60px;
            left: 20px;
            max-width: 300px;
            background-color: rgba(0, 0, 0, 0.6);
            padding: 15px;
            border-radius: 5px;
        }
        #notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background-color: rgba(0, 0, 0, 0.8);
            color: #fff;
            padding: 10px 15px;
            border-radius: 5px;
            z-index: 1000;
            display: none;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Josh Jacobs - Portfolio</h1>
    </div>
    <div id="notification">Status message will appear here</div>
    <div id="instructions">
        <p><strong>Here is a selection of many projects I've created or helped to create over the years.</strong></p>
        <p>Click a cube to listen!</p>
    </div>
    <div id="content-wrapper">
        <div id="canvas"></div>
        <div id="info">
            <h2 id="project-title">Project Title</h2>
            <p id="project-description">Project description will appear here.</p>
            <p class="click-hint">Listen →</p>
        </div>
    </div>

    <!-- Import Three.js from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.132.2/build/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.132.2/examples/js/controls/OrbitControls.js"></script>
    
    <!-- Import portfolio data -->
    <script src="js/portfolio-data.js"></script>
    
    <!-- Main script -->
    <script>
        // Demo script for a portfolio grid of cubes
        
        // Global variables
        let scene, camera, renderer, controls;
        let cubes = [];
        let cubeGroup; // Added missing group reference
        let raycaster, mouse;
        let selectedItem = null;
        let hoveredCube = null;
        
        // Helper function to show notification
        function showNotification(message, isError = false) {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.style.backgroundColor = isError ? 'rgba(255, 50, 50, 0.8)' : 'rgba(0, 150, 0, 0.8)';
            notification.style.display = 'block';
            
            setTimeout(() => {
                notification.style.display = 'none';
            }, 5000);
        }
        
        // Initialize the scene, camera, and renderer
        function init() {
            // Create scene
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x111111);
            
            // Create perspective camera for natural depth
            const fov = 40; // lower field of view for less distortion
            const aspect = window.innerWidth / window.innerHeight;
            const near = 1;
            const far = 1000;
            
            camera = new THREE.PerspectiveCamera(fov, aspect, near, far);
            camera.position.set(0, 0, 40);  // Pull back even further for larger cubes
            camera.lookAt(0, 0, 0);
            
            // Create renderer
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            document.getElementById('canvas').appendChild(renderer.domElement);
            
            // Setup raycaster for mouse interaction
            raycaster = new THREE.Raycaster();
            mouse = new THREE.Vector2();
            
            let cubeGroup = new THREE.Group();
            scene.add(cubeGroup);
            
            // Orbit controls
            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.1;
            controls.enablePan = false;
            controls.enableZoom = false;
            controls.enabled = false; // Still disabled for a fixed view
            
            // Lights
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);
            
            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(1, 1, 1);
            scene.add(directionalLight);
            
            // Events
            window.addEventListener('resize', onWindowResize, false);
            window.addEventListener('mousemove', onMouseMove, false);
            window.addEventListener('click', onMouseClick, false);
            
            if (window.location.protocol === 'file:') {
                showNotification("Error: This demo must be run from a web server (http/https), not directly from a file (file://).", true);
            }
        
            // Create cubes
            createCubes();
        }
        
        // Create cubes for all portfolio items, grouped by project type
        function createCubes() {
            const textureLoader = new THREE.TextureLoader();
            const cubeSize = 6.0;         // Cube size
            const spacing = 10.5;         // Space between cubes in the same group
            const baseGroupSpacing = 1.0;   // Base spacing between different project types
            const itemsPerRow = 3;       // Number of cubes per row
            
            // Function to create a text label for a group
            function createGroupLabel(text, position) {
                const canvas = document.createElement('canvas');
                const context = canvas.getContext('2d');
                canvas.width = 512;  // Wider canvas for group headers
                canvas.height = 64;
                
                // Draw background
                context.fillStyle = 'rgba(0, 0, 0, 0.7)';
                context.fillRect(0, 0, canvas.width, canvas.height);
                
                // Draw text
                context.fillStyle = '#ffffff';
                context.font = 'bold 32px Arial';
                context.textAlign = 'center';
                context.fillText(text, canvas.width / 2, 42);
                
                // Create texture and material
                const texture = new THREE.CanvasTexture(canvas);
                const material = new THREE.MeshBasicMaterial({ 
                    map: texture,
                    transparent: true,
                    depthWrite: false
                });
                
                // Create mesh - wider than regular labels
                const geometry = new THREE.PlaneGeometry(12, 1.5);
                const label = new THREE.Mesh(geometry, material);
                label.position.copy(position);
                
                // Add to scene
                scene.add(label);
                return label;
            }

            
            // Sort items by project type according to projectTypeOrder
            // Within each project type, sort by release date (newest first)
            const groupedItems = {};
            projectTypeOrder.forEach(type => {
                // Filter by project type then sort by releaseDate in descending order (newest first)
                groupedItems[type] = portfolioDatabase
                    .filter(item => item.projectType === type)
                    .sort((a, b) => new Date(b.releaseDate) - new Date(a.releaseDate));
            });
            
            // Calculate total needed space
            let totalVerticalSpace = 0;
            let maxRows = 0;
            
            projectTypeOrder.forEach(type => {
                const items = groupedItems[type];
                if (items.length > 0) {
                    const rows = Math.ceil(items.length / itemsPerRow);
                    totalVerticalSpace += rows * spacing;
                    totalVerticalSpace += baseGroupSpacing;
                    maxRows += rows;
                }
            });
            
            // Calculate height needed for all items with MUCH more padding
            const totalGridHeight = totalVerticalSpace * 10; // Much higher multiplier
            
            // Set a very generous minimum height - at least 3x the window height plus calculated space
            const canvasMinHeight = Math.max(window.innerHeight * 3, totalGridHeight * 4);
            
            // Create a very tall scrollable space for all content
            document.getElementById('content-wrapper').style.minHeight = `${canvasMinHeight}px`;
            
            // Add extra padding at the bottom of the document
            const bodyPadding = document.createElement('div');
            bodyPadding.style.height = `${canvasMinHeight}px`;
            bodyPadding.style.width = '100%';
            bodyPadding.style.position = 'absolute';
            bodyPadding.style.top = '0';
            bodyPadding.style.zIndex = '-2';
            document.body.appendChild(bodyPadding);
            
            // Track vertical position for each group
            let currentYPosition = 10; // Start from top with offset
            
            // Create cubes for each project type group
            projectTypeOrder.forEach(projectType => {
                const items = groupedItems[projectType];
                
                if (items.length > 0) {
                    // Add group label
                    const labelPosition = new THREE.Vector3(0, currentYPosition, 0);
                    createGroupLabel(projectType, labelPosition);
                    
                    // Move down after label (smaller gap)
                    currentYPosition -= 6;
                    
                    // Create cubes for this group
                    items.forEach((item, index) => {
                        const row = Math.floor(index / itemsPerRow);
                        const col = index % itemsPerRow;
                        
                        // Determine if this is the last row and has fewer items
                        const isLastRowWithFewerItems = (row === Math.floor((items.length - 1) / itemsPerRow)) && 
                                                         (items.length % itemsPerRow !== 0);
                                                         
                        // Calculate how many items are in this row
                        const itemsInThisRow = isLastRowWithFewerItems ? (items.length % itemsPerRow) : itemsPerRow;
                        
                        // Adjust the offset for centering in last row if needed
                        const rowOffset = isLastRowWithFewerItems ? (itemsPerRow - itemsInThisRow) / 2 : 0;
                        
                        // Calculate position with the adjusted offset
                        const xPos = (col + rowOffset - (itemsPerRow - 1) / 2) * spacing;
                        const yPos = currentYPosition - (row * spacing);
                        
                        textureLoader.load(
                            item.image,
                            function(texture) {
                                // Create materials with the texture
                                const materials = Array(6).fill().map(() =>
                                    new THREE.MeshStandardMaterial({
                                        map: texture,
                                        emissive: new THREE.Color(0x000000),
                                        emissiveIntensity: 1
                                    })
                                );
                                
                                // Create cube
                                const geometry = new THREE.BoxGeometry(cubeSize, cubeSize, cubeSize);
                                const cube = new THREE.Mesh(geometry, materials);
                                
                                // Position cube
                                cube.position.set(xPos, yPos, 0);
                                cube.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
                                
                                // Store reference to the portfolio item
                                cube.userData = {
                                    portfolioItem: item
                                };
                                
                                // Add to scene
                                scene.add(cube);
                                if (cubeGroup) cubeGroup.add(cube);
                                cubes.push(cube);
                                
                            }
                        );
                    });
                    
                    // Calculate rows for this group and update current Y position
                    const rows = Math.ceil(items.length / itemsPerRow);
                    currentYPosition -= (rows * spacing) + baseGroupSpacing; // Move down by rows plus fixed group spacing
                }
            });
        }
        
        // Handle window resize
        function onWindowResize() {
            // Update aspect ratio
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            
            // Update renderer size
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // Limit for better performance
        }
        
        // Handle mouse movement
        function onMouseMove(event) {
            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
        
            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(cubes);
        
            if (intersects.length > 0) {
                const cube = intersects[0].object;
        
                if (hoveredCube && hoveredCube !== cube) {
                    // Reset previous cube emissive
                    hoveredCube.material.forEach(mat => mat.emissive.set(0x000000));
                    // Hide info panel when moving to a different cube
                    document.getElementById('info').style.display = 'none';
                }
        
                // Apply glow to hovered cube
                hoveredCube = cube;
                cube.material.forEach(mat => mat.emissive.set(0x5f5f5f));
                
                // Show info panel for the hovered cube
                const item = cube.userData.portfolioItem;
                if (item) {
                    displayProjectInfo(item);
                }
            } else {
                if (hoveredCube) {
                    hoveredCube.material.forEach(mat => mat.emissive.set(0x000000));
                    hoveredCube = null;
                    // Hide info panel when not hovering over any cube
                    document.getElementById('info').style.display = 'none';
                }
            }
        }
        
        // Handle mouse click
        function onMouseClick() {
            // Update the raycaster with the camera and mouse position
            raycaster.setFromCamera(mouse, camera);
            
            // Calculate objects intersecting the picking ray
            const intersects = raycaster.intersectObjects(cubes);
            
            if (intersects.length > 0) {
                // Get the first intersected cube
                const clickedCube = intersects[0].object;
                
                // Get the portfolio item associated with this cube
                const item = clickedCube.userData.portfolioItem;
                
                if (item && item.url) {
                    // Open the URL directly when clicking
                    window.open(item.url, '_blank');
                }
            }
        }
        
        // Display project information
        function displayProjectInfo(item) {
            selectedItem = item;
            
            document.getElementById('project-title').textContent = `${item.artistName} - ${item.projectName}`;
            document.getElementById('project-description').textContent = item.description;
            
            // Position and show the info panel
            const infoElement = document.getElementById('info');
            
            // Calculate position to be near the mouse but avoid edge clipping
            const windowWidth = window.innerWidth;
            const windowHeight = window.innerHeight;
            const panelWidth = 400; // Approximate width of info panel
            const panelHeight = 200; // Approximate height of info panel
            
            // Show the info panel
            infoElement.style.display = 'block';
        }
        
        // Animation loop
        function animate() {
            requestAnimationFrame(animate);
        
            const scrollY = window.scrollY || document.documentElement.scrollTop;
            
            // Check if cubeGroup exists before trying to use it
            if (cubeGroup) {
                // Use a more significant scrolling effect
                // This allows viewing all cubes with reasonable scroll distance
                cubeGroup.position.y = scrollY * 0.5;
                
                // Don't let the cubes go too far off-screen at the top
                if (cubeGroup.position.y > 5000) {
                    cubeGroup.position.y = 5000;
                }
            }
            
            // Adjust camera position more significantly based on scroll 
            // Use a non-linear function to allow more scrolling range
            camera.position.y = -Math.min(scrollY * 0.025, 2000);
            
        
            // Allow rotation again
            cubes.forEach(cube => {
                cube.rotation.y += 0.005;
                cube.rotation.x += 0.003;
            });
        
            renderer.render(scene, camera);
        }
        
        // Start the application
        init();
        animate();
    </script>
</body>
</html>